# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/voting_system?retryWrites=true&w=majority

# Blockchain Configuration
RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_PROJECT_ID
CONTRACT_ADDRESS=0x...  # Set after deployment
ADMIN_PRIVATE_KEY=0x...  # Private key for contract deployment and admin operations
ADMIN_ADDRESS=0x...      # Public address corresponding to private key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Face Verification (Optional)
FACE_VERIFICATION_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true